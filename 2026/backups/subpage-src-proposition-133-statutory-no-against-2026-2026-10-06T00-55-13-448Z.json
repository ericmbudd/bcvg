  {
    "children": [
      {
        "detail": 0,
        "format": 0,
        "mode": "normal",
        "style": "",
        "text": "Proposition 133 relies on our worst instincts to enact unhelpful tough-on-crime sentencing and will not make us or our children any safer.",
        "type": "extended-text",
        "version": 1
