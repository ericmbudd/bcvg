[
  {
    "children": [
      {
        "detail": 0,
        "format": 0,
        "mode": "normal",
        "style": "",
        "text": "Shall there be an amendment to the Colorado Constitution creating new law granting the right for consumers to purchase natural gas for cooking or heating in homes or businesses and for distributors and utilities to sell natural gas to consumers?",
        "type": "extended-text",
        "version": 1
      }
    ],
    "direction": "ltr",
    "format": "",
    "indent": 0,
    "type": "extended-quote",
    "version": 1
  },
  {
    "children": [
      {
        "detail": 0,
        "format": 0,
        "mode": "normal",
        "style": "",
        "text": "Who put the measure on the ballot?",
        "type": "extended-text",
        "version": 1
      }
    ],
    "direction": "ltr",
    "format": "",
    "indent": 0,
    "type": "extended-heading",
    "version": 1,
    "tag": "h2"
  },
  {
    "children": [
      {
        "detail": 0,
        "format": 0,
        "mode": "normal",
        "style": "",
        "text": "Amendment 82 was placed on the ballot through a citizen initiative backed by operatives of ",
        "type": "extended-text",
        "version": 1
      },
      {
        "children": [
          {
            "detail": 0,
            "format": 8,
