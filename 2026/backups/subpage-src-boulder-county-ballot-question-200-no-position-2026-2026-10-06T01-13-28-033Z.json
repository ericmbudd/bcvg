          },
          {
            "detail": 0,
            "format": 0,
            "mode": "normal",
            "style": "",
            "text": " — Daily Camera",
            "type": "extended-text",
            "version": 1
          }
        ],
        "direction": "ltr",
        "format": "",
        "indent": 0,
        "type": "listitem",
        "version": 1,
        "value": 3
      },
      {
        "children": [
          {
            "children": [
              {
                "detail": 0,
                "format": 0,
