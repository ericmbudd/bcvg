                "detail": 0,
                "format": 0,
                "mode": "normal",
                "style": "",
                "text": "Boulder County petition effort clears hurdle for ballot measure to expand county commissioners from 3 to 5",
                "type": "extended-text",
                "version": 1
              }
            ],
            "direction": "ltr",
