    "type": "extended-heading",
    "version": 1,
    "tag": "h2"
  },
  {
    "children": [
      {
        "detail": 0,
        "format": 0,
        "mode": "normal",
        "style": "",
        "text": "Support. Proposition NN was placed on the ballot with Democratic support from the state legislature through ",
        "type": "extended-text",
        "version": 1
      },
      {
        "children": [
          {
            "detail": 0,
            "format": 8,
            "mode": "normal",
            "style": "",
