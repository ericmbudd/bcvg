        "memberSegment": "status:free,status:-free"
      }
    }
  },
  {
    "children": [
      {
        "detail": 0,
        "format": 0,
        "mode": "normal",
        "style": "",
        "text": "For many years, Colorado was known as “The Hate State” ",
        "type": "extended-text",
        "version": 1
      },
      {
        "children": [
          {
            "detail": 0,
            "format": 8,
            "mode": "normal",
            "style": "",
            "text": "for passing Amendment 2",
            "type": "extended-text",
            "version": 1
          }
        ],
        "direction": "ltr",
        "format": "",
        "indent": 0,
        "type": "link",
        "version": 1,
        "rel": null,
        "target": null,
        "title": null,
        "url": "https://www.ksut.org/history/2024-11-11/ending-the-hate-state-coloradans-were-shocked-and-outraged-after-passage-of-anti-gay-amendment"
      },
      {
        "detail": 0,
        "format": 0,
        "mode": "normal",
        "style": "",
        "text": " in 1992, banning LGBTQ marriage in the state’s constitution. We finally undid that wrong by overturning that amendment in 2024. Let’s not go down that path again.",
        "type": "extended-text",
        "version": 1
      }
    ],
    "direction": "ltr",
    "format": "",
    "indent": 0,
    "type": "paragraph",
    "version": 1
  },
