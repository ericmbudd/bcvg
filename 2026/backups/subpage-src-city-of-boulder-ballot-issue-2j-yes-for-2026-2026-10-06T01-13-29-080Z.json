        "format": 0,
        "mode": "normal",
        "style": "",
        "text": "Additional Reporting, Commentary, and Sources",
        "type": "extended-text",
        "version": 1
      }
    ],
    "direction": "ltr",
    "format": "",
    "indent": 0,
    "type": "extended-heading",
