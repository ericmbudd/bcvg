      },
      {
        "detail": 0,
        "format": 0,
        "mode": "normal",
        "style": "",
        "text": ", a right-wing group supporting numerous measures on Colorado’s 2026 ballot.",
        "type": "extended-text",
        "version": 1
      }
    ],
    "direction": "ltr",
    "format": "",
    "indent": 0,
    "type": "paragraph",
    "version": 1
  },
  {
    "children": [
      {
        "detail": 0,
        "format": 0,
        "mode": "normal",
        "style": "",
        "text": "Short Description:",
        "type": "extended-text",
        "version": 1
      }
    ],
    "direction": "ltr",
