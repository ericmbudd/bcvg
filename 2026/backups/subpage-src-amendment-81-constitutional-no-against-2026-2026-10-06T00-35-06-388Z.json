[
  {
    "children": [
      {
        "detail": 0,
        "format": 0,
        "mode": "normal",
        "style": "",
        "text": "Shall there be an amendment to the Colorado Constitution requiring law enforcement to notify the department of homeland security when a person is charged with either a violent crime or any crime if the person has a prior felony conviction if law enforcement cannot determine that the person is lawfully present in the United States?",
        "type": "extended-text",
        "version": 1
      }
    ],
    "direction": "ltr",
    "format": "",
    "indent": 0,
    "type": "extended-quote",
    "version": 1
  },
  {
    "children": [
      {
        "detail": 0,
        "format": 0,
        "mode": "normal",
        "style": "",
        "text": "Who put the measure on the ballot?",
        "type": "extended-text",
        "version": 1
      }
    ],
    "direction": "ltr",
    "format": "",
    "indent": 0,
    "type": "extended-heading",
    "version": 1,
    "tag": "h2"
  },
  {
    "children": [
      {
        "detail": 0,
        "format": 0,
        "mode": "normal",
        "style": "",
        "text": "Amendment 81 was placed on the ballot through a citizen initiative backed by operatives of ",
        "type": "extended-text",
        "version": 1
      },
      {
        "children": [
          {
            "detail": 0,
            "format": 8,
            "mode": "normal",
            "style": "",
            "text": "Advance Colorado",
            "type": "extended-text",
            "version": 1
          }
        ],
        "direction": "ltr",
